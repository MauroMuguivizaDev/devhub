# ==============================
# DevHub - Global Git Ignore
# ==============================

# Environment / secrets
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# ==============================
# Java / Spring Boot
# ==============================

**/target/
**/.mvn/wrapper/maven-wrapper.jar

# ==============================
# Node / React
# ==============================

**/node_modules/
**/dist/
**/build/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ==============================
# Python
# ==============================

**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.venv/
**/venv/
**/.env

# ==============================
# C / C++
# ==============================

**/build/
**/cmake-build-*/
**/.cache/
**/*.o
**/*.obj
**/*.out

# ==============================
# IDEs
# ==============================

.vscode/
.idea/
*.iml

# ==============================
# Coverage
# ==============================

coverage/
htmlcov/
.pytest_cache/

